# Copy to .env (chmod 600). Leave YOUCAM_API_KEY empty to run in demo mode.
# Only YOUCAM_API_KEY and UNSTACK_* names are read; generic names such as
# OPENAI_API_KEY or LLM_API_KEY are ignored on purpose.

# YouCam API key (scripts/set-youcam-key.sh writes it without echoing it).
YOUCAM_API_KEY=

# Hard cap on YouCam units this server may spend (default 200, never above 1000).
UNSTACK_UNIT_CAP=200
# Paid YouCam tasks per hour (default 12).
UNSTACK_MAX_TASKS_PER_HOUR=12
# Set to 1 to force demo mode even when a key is present.
UNSTACK_FORCE_MOCK=

# Optional label reader (vision LLM on Nebius Token Factory). Off when empty.
UNSTACK_NEBIUS_API_KEY=
UNSTACK_NEBIUS_MODEL=openbmb/MiniCPM-V-4_5
# USD cap on label-reader spend (default 1, never above 1).
UNSTACK_LLM_CAP_USD=1

# UNSTACK_PORT=8796
# UNSTACK_HOST=127.0.0.1
# UNSTACK_DATA_DIR=data
